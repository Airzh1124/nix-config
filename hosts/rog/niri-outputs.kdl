// Find output names with `niri msg outputs`.
// https://niri-wm.github.io/niri/Configuration:-Outputs

// Match by make/model: connector names (eDP-1 vs eDP-2, DP-3 vs DP-2) swap
// between boots depending on whether i915 or nvidia-drm initializes first.
output "BOE NE160QDM-NZC Unknown" {
    // niri turns this panel off while the lid is closed and the desk
    // monitor is connected.
    mode "2560x1600@240.000"
    scale 1.5
}

output "PNP(AOC) Q24G41ZE XLSRCHA006583" {
    // The monitor advertises 60 Hz as preferred, so pin its native maximum.
    mode "2560x1440@240.002"
    scale 1.5
    focus-at-startup
}
